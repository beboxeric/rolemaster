# 复制为 .env，填入真实值

# 数据库（PostgreSQL）
# 本地开发：postgresql://postgres:password@localhost:5432/rolemaster
# Supabase：在项目设置 → Database → Connection string 中获取
DATABASE_URL="postgresql://user:password@localhost:5432/rolemaster"

# JWT 签名密钥（随机字符串，生产环境用 openssl rand -hex 32 生成）
JWT_SECRET="local-dev-secret-change-in-production"

# 服务端口
PORT=3000

# AI（DashScope / 阿里云 Qwen）
QWEN_API_KEY=""
QWEN_MODEL="qwen-plus"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Cloudflare R2 文件存储（兼容 S3 API）
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="rolemaster-files"
R2_PUBLIC_URL=""

# 前端地址（用于 CORS 允许列表）
FRONTEND_URL="http://localhost:5173"
