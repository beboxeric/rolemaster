generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id         String   @id
  email      String   @unique
  password   String
  salt       String
  name       String
  role       String   // supplier | curator | sales
  supplierId String?  @map("supplier_id")
  language   String?
  isSuper    Boolean  @default(false) @map("is_superadmin")
  createdAt  DateTime @default(now()) @map("created_at")

  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  notifications Notification[]

  @@map("users")
}

// ── Suppliers ─────────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id
  name      String
  shortName String   @map("short_name")
  hq        String
  contact   String?
  phone     String?
  founded   Int?
  team      String?
  clients   Int?
  createdAt DateTime @default(now()) @map("created_at")

  users       User[]
  intakes     Intake[]
  rolepacks   Rolepack[]
  products    Product[]
  companyInfo SupplierCompanyInfo?

  @@map("suppliers")
}

// ── Intakes (supplier submission flow) ───────────────────────────────────────

model Intake {
  id                 String    @id
  supplierId         String    @map("supplier_id")
  name               String?
  freeText           String?   @map("free_text")
  industryHint       String?   @map("industry_hint")
  website            String?
  servicePricingJson Json?     @map("service_pricing_json")
  status             String    @default("draft")
  finalizedAt        DateTime? @map("finalized_at")
  submittedAt        DateTime? @map("submitted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fields        IntakeField[]
  files         IntakeFile[]
  auditLogs     AuditLog[]
  chatMessages  ChatMessage[]
  capabilities  Capability[]
  intakeRolepacks IntakeRolepack[]
  generated     IntakeGenerated?
  salesMaterials SalesMaterialsDraft?
  comments      IntakeComment[]

  @@map("intakes")
}

// Per-section form fields for an intake (bilingual)
model IntakeField {
  intakeId String  @map("intake_id")
  fieldId  String  @map("field_id")
  section  Int
  labelZh  String  @map("label_zh")
  labelEn  String  @map("label_en")
  valueZh  String? @map("value_zh")
  valueEn  String? @map("value_en")
  status   String  // ai | filled | empty | weak
  hintZh   String? @map("hint_zh")
  hintEn   String? @map("hint_en")
  optional Boolean @default(false)

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@id([intakeId, fieldId])
  @@map("intake_fields")
}

// Uploaded materials for an intake
model IntakeFile {
  id            String   @id
  intakeId      String   @map("intake_id")
  kind          String   // pdf | ppt | doc | voice | other
  filename      String
  displayName   String?  @map("display_name")
  sizeBytes     Int      @map("size_bytes")
  storageKey    String   @map("storage_key")  // R2 object key
  rolepackId    String?  @map("rolepack_id")
  extractedText String?  @map("extracted_text")
  createdAt     DateTime @default(now()) @map("created_at")

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_files")
}

// AI-extracted or supplier-authored capabilities (RC-01, RC-02, …)
model Capability {
  id            String   @id
  intakeId      String   @map("intake_id")
  rcLabel       String   @map("rc_label")   // RC-01, RC-02, …
  nameZh        String?  @map("name_zh")
  nameEn        String?  @map("name_en")
  descriptionZh String?  @map("description_zh")
  descriptionEn String?  @map("description_en")
  sourceQuote   String?  @map("source_quote")
  sourceQuoteEn String?  @map("source_quote_en")
  confidence    Float?
  position      Int      @default(0)
  source        String   @default("ai")    // ai | supplier
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  editedAt      DateTime? @map("edited_at")

  intake              Intake               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  rolepackCapabilities RolepackCapability[]

  @@map("capabilities")
}

// Draft rolepacks (RP-01, RP-02, …) linked to an intake — supplier authors these
model IntakeRolepack {
  id               String   @id
  intakeId         String   @map("intake_id")
  rpLabel          String   @map("rp_label")  // RP-01, RP-02, …
  nameZh           String?  @map("name_zh")
  nameEn           String?  @map("name_en")
  industryJson     Json     @default("[]") @map("industry_json")
  companySizeJson  Json     @default("[]") @map("company_size_json")
  departmentJson   Json     @default("{}") @map("department_json")
  questionnaireJson Json?   @map("questionnaire_json")
  generatedJson      Json?    @map("generated_json")
  materialsDraftJson Json?    @map("materials_draft_json")
  position           Int      @default(0)
  status           String   @default("draft")  // draft | published
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  intake       Intake               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  capabilities RolepackCapability[]
  chatMessages ChatMessage[]

  @@map("intake_rolepacks")
}

// Junction: which capabilities belong to which draft rolepack
model RolepackCapability {
  rolepackId   String @map("rolepack_id")
  capabilityId String @map("capability_id")
  position     Int    @default(0)

  rolepack   IntakeRolepack @relation(fields: [rolepackId], references: [id], onDelete: Cascade)
  capability Capability     @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([rolepackId, capabilityId])
  @@map("rolepack_capabilities")
}

// ── Published Catalog ─────────────────────────────────────────────────────────

model Rolepack {
  id                 String    @id
  supplierId         String?   @map("supplier_id")
  supplierName       String    @map("supplier_name")
  data               Json
  publishedAt        DateTime  @default(now()) @map("published_at")
  pitchDeckZhUrl     String?   @map("pitch_deck_zh_url")
  pitchDeckEnUrl     String?   @map("pitch_deck_en_url")
  productManualZhUrl String?   @map("product_manual_zh_url")
  productManualEnUrl String?   @map("product_manual_en_url")
  assetStatus        String    @default("pending") @map("asset_status")
  assetGeneratedAt   DateTime? @map("asset_generated_at")
  assetFailedReason  String?   @map("asset_failed_reason")

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@map("rolepacks")
}

// ── Audit & Messaging ─────────────────────────────────────────────────────────

model AuditLog {
  id       Int      @id @default(autoincrement())
  intakeId String?  @map("intake_id")
  who      String
  actionZh String   @map("action_zh")
  actionEn String   @map("action_en")
  createdAt DateTime @default(now()) @map("created_at")

  intake Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  intakeId   String?  @map("intake_id")
  rolepackId String?  @map("rolepack_id")
  role       String
  content    String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  intake   Intake?        @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  rolepack IntakeRolepack? @relation(fields: [rolepackId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model IntakeComment {
  id         String   @id
  intakeId   String   @map("intake_id")
  authorId   String   @map("author_id")
  authorRole String   @map("author_role")  // curator | supplier
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_comments")
}

// ── AI-Generated Content ──────────────────────────────────────────────────────

model IntakeGenerated {
  intakeId                   String    @id @map("intake_id")
  customerVoicePainZh        String?   @map("customer_voice_pain_zh")
  customerVoicePainEn        String?   @map("customer_voice_pain_en")
  valuePositioningZh         String?   @map("value_positioning_zh")
  valuePositioningEn         String?   @map("value_positioning_en")
  capabilitySummaryZh        String?   @map("capability_summary_zh")
  capabilitySummaryEn        String?   @map("capability_summary_en")
  oneLinerZh                 String?   @map("one_liner_zh")
  oneLinerEn                 String?   @map("one_liner_en")
  aiAssemblyRecommendationZh String?   @map("ai_assembly_recommendation_zh")
  aiAssemblyRecommendationEn String?   @map("ai_assembly_recommendation_en")
  aiAssemblyAlternativesJson Json?     @map("ai_assembly_alternatives_json")
  generatedAt                DateTime? @map("generated_at")
  generatedBy                String?   @map("generated_by")

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_generated")
}

model SalesMaterialsDraft {
  intakeId               String    @id @map("intake_id")
  pitchOutlineJson       Json?     @map("pitch_outline_json")
  faqJson                Json?     @map("faq_json")
  elevatorPitchZh        String?   @map("elevator_pitch_zh")
  elevatorPitchEn        String?   @map("elevator_pitch_en")
  discoveryQuestionsJson Json?     @map("discovery_questions_json")
  generatedAt            DateTime? @map("generated_at")
  editedAt               DateTime? @map("edited_at")

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("sales_materials_draft")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id
  userId      String    @map("user_id")
  type        String
  payloadJson Json?     @map("payload_json")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ── Taxonomy ──────────────────────────────────────────────────────────────────

model TaxonomyIndustry {
  id           String   @id
  nameZh       String   @map("name_zh")
  nameEn       String   @map("name_en")
  parentId     String?  @map("parent_id")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  parent   TaxonomyIndustry?  @relation("IndustryHierarchy", fields: [parentId], references: [id])
  children TaxonomyIndustry[] @relation("IndustryHierarchy")

  @@map("taxonomy_industries")
}

// ── Products & Company Info ───────────────────────────────────────────────────

model Product {
  id         String   @id
  supplierId String   @map("supplier_id")
  name       String
  subtitleZh String?  @map("subtitle_zh")
  subtitleEn String?  @map("subtitle_en")
  position   Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("products")
}

model SupplierCompanyInfo {
  supplierId       String   @id @map("supplier_id")
  companyNameZh    String?  @map("company_name_zh")
  companyNameEn    String?  @map("company_name_en")
  companyHqZh      String?  @map("company_hq_zh")
  companyHqEn      String?  @map("company_hq_en")
  companyFoundedZh String?  @map("company_founded_zh")
  companyFoundedEn String?  @map("company_founded_en")
  companyTeamZh    String?  @map("company_team_zh")
  companyTeamEn    String?  @map("company_team_en")
  companyClientsZh String?  @map("company_clients_zh")
  companyClientsEn String?  @map("company_clients_en")
  website          String?  @map("website")
  contactName      String?  @map("contact_name")
  contactPhone     String?  @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_company_info")
}

// ── Misc ──────────────────────────────────────────────────────────────────────

model SalesSession {
  id         String   @id
  userId     String?  @map("user_id")
  email      String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  signedInAt DateTime @default(now()) @map("signed_in_at")
  expiresAt  DateTime @map("expires_at")

  @@map("sales_sessions")
}

model PlatformLog {
  id          String   @id
  level       String   // info | warn | error
  message     String
  contextJson Json?    @map("context_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_logs")
}
